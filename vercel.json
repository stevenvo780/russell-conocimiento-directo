{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/presentacion",
      "destination": "/index.html"
    },
    {
      "source": "/presentacion/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/fuentes",
      "destination": "/index.html"
    },
    {
      "source": "/fuentes/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
